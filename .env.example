# WebOllama Configuration

# Flask App Configuration
PORT=5000
HOST=0.0.0.0
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# Ollama API Configuration
# For local: http://127.0.0.1:11434
# For docker: http://ollama:11434 (if on same network) or http://host.docker.internal:11434
OLLAMA_API_BASE=http://ollama:11434

# ============================================================
# Terminal Configuration (optional)
# ============================================================

# Mode: "local" or "docker"
#   local  — spawn a shell directly inside the webollama container
#   docker — docker exec into another container (requires Docker socket mount)
WEBOLLAMA_TERMINAL_MODE=local

# Shell path for local mode
WEBOLLAMA_TERMINAL_SHELL=/bin/bash

# Prompt (PS1) — bash escape sequences
WEBOLLAMA_TERMINAL_PROMPT=\u@webollama:\w$ 

# Auth token for terminal access
# If set, clients must send this token via WebSocket to use the terminal
# Leave empty to disable auth
WEBOLLAMA_TERMINAL_AUTH=

# --- Docker exec mode settings (only used when MODE=docker) ---

# Container name to exec into
WEBOLLAMA_TERMINAL_DOCKER_CONTAINER=

# Shell inside the target container
WEBOLLAMA_TERMINAL_DOCKER_SHELL=/bin/bash

# ============================================================
# Docker Compose notes:
#   - For docker exec mode, mount the Docker socket:
#       volumes:
#         - /var/run/docker.sock:/var/run/docker.sock
#   - To skip installing Ollama CLI (smaller image):
#       docker compose build --build-arg INSTALL_OLLAMA_CLI=false
# ============================================================